{
	"lsp": {
		"tailwindcss-language-server": {
			"settings": {
				"includeLanguages": {
					"svelte": "html"
				},
				"classFunctions": ["cva", "cx"],
				"experimental": {
					"classRegex": [
						"class=\"([^\"]*)\"",
						"class='([^']*)'",
						"class:\\s*([^\\s{]+)",
						"\\{\\s*class:\\s*\"([^\"]*)\"",
						"\\{\\s*class:\\s*'([^']*)'"
					]
				}
			}
		},
		"eslint": {
			"settings": {
				"run": "onType",
				"codeActionsOnSave": {
					"mode": "all"
				}
			}
		}
	},
	"languages": {
		"CSS": { "format_on_save": "on", "formatter": "prettier" },
		"JavaScript": { "format_on_save": "on", "formatter": "prettier" },
		"JSX": { "format_on_save": "on", "formatter": "prettier" },
		"JSON": { "format_on_save": "on", "formatter": "prettier" },
		"JSON5": { "format_on_save": "on", "formatter": "prettier" },
		"JSONC": { "format_on_save": "on", "formatter": "prettier" },
		"Markdown": { "format_on_save": "on", "formatter": "prettier" },
		"Svelte": { "format_on_save": "on", "formatter": "prettier" },
		"TypeScript": { "format_on_save": "on", "formatter": "prettier" },
		"TSX": { "format_on_save": "on", "formatter": "prettier" }
	}
}
